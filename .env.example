# Contact Us form -> email
# Copy this file to .env.local (local) or add these in your hosting provider's
# Environment Variables settings (production). Never commit the real password.

# Gmail account that sends the lead emails
GMAIL_USER=bawaskarfiberarts@gmail.com

# 16-character Gmail App Password (Google Account > Security > 2-Step Verification > App passwords)
GMAIL_APP_PASSWORD=

# Optional: inbox that receives the leads (defaults to bawaskarfiberarts@gmail.com)
# CONTACT_TO=bawaskarfiberarts@gmail.com
